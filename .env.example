# Universal MCP Cloud — Environment Configuration
# Copy to .env and fill in values

# ─── Core ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=universal-mcp-cloud
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000

# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://umcp:umcp_dev_password@localhost:5432/umcp?schema=public

# ─── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ─────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production-must-be-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Magic Link
MAGIC_LINK_SECRET=dev-magic-link-secret-change-in-production
MAGIC_LINK_EXPIRY=15m

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# WebAuthn (Passkeys)
WEBAUTHN_RP_NAME=Universal MCP Cloud
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Encryption ─────────────────────────────────────
# 32-byte hex-encoded master key for AES-256-GCM
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Email ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@umcp.dev

# ─── S3 / MinIO ────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=umcp_minio
S3_SECRET_KEY=umcp_minio_secret
S3_BUCKET=umcp-storage

# ─── OpenSearch ─────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# ─── Sentry ─────────────────────────────────────────
SENTRY_DSN=

# ─── Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── MCP ────────────────────────────────────────────
MCP_ENDPOINT_BASE=http://localhost:4000/mcp
