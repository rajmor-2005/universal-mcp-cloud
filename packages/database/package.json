{
  "name": "@umcp/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "generate": "npx dotenv-cli -e ../../.env -- prisma generate",
    "migrate": "npx dotenv-cli -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "npx dotenv-cli -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "npx dotenv-cli -e ../../.env -- prisma migrate reset --force",
    "seed": "npx dotenv-cli -e ../../.env -- tsx prisma/seed.ts",
    "studio": "npx dotenv-cli -e ../../.env -- prisma studio",
    "push": "npx dotenv-cli -e ../../.env -- prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
